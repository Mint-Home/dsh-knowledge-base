{
  "name": "@local/knowledge-base",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local knowledge base for the DeepSeek Harness: structured entries, keyword search, agent tools, automatic context injection, and a sidebar panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
